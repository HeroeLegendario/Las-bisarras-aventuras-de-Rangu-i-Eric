; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "KinematicBody2D",
"class": @"BaseMainCharacter",
"language": @"PScript",
"path": "res://scripts/base_classes/base_main_character.p"
}, {
"base": "Resource",
"class": @"CharacterSheetResource",
"language": @"PScript",
"path": "res://scripts/resource_classes/character_sheet_resource.p"
}, {
"base": "Resource",
"class": @"StoryFolderResource",
"language": @"PScript",
"path": "res://scripts/resource_classes/story_folder_resource.p"
} ]
_global_script_class_icons={
"BaseMainCharacter": "",
"CharacterSheetResource": "",
"StoryFolderResource": ""
}

[application]

config/name="Las bisarras aventuras de Rangu i eric"
config/use_custom_user_dir=true
config/custom_user_dir_name="LegendaryHero/SJ-RPG"
config/icon="res://icon.png"

[autoload]

GlobalDefinitions="*res://autoloads/global_definitions.p"

[debug]

pscript/completion/autocomplete_setters_and_getters=true
pscript/warnings/unused_argument=true
pscript/warnings/unsafe_cast=true
pscript/warnings/unsafe_call_argument=true

[display]

window/size/width=512
window/size/height=448
window/size/fullscreen=true
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[editor]

scene_naming=2
default_language=2
script_templates_search_path="res://.script_templates"

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/custom_font="res://assets/font/sergamon.tres"

[physics]

common/enable_pause_aware_picking=true

[rendering]

quality/driver/driver_name="GLES3"
environment/default_clear_color=Color( 0, 0, 0, 1 )
environment/default_environment="res://default_env.tres"
